
---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ClubHub from '../components/ClubHub.astro';
import Teams from '../components/Teams.astro';
---

<MainLayout title="NK Gavran 2003 | Lanište, Zagreb">

  <Hero />
  <ClubHub />
  <Teams />

  <!-- POVIJEST KLUBA -->
  <section class="section history-section" id="povijest">
    <div class="container">

      <!-- Isti stil naslova kao ostale sekcije -->
      <div class="section-head">
        <div>
          <div class="eyebrow">NAŠA PRIČA · LANIŠTE, ZAGREB</div>
          <h2>POVIJEST KLUBA</h2>
          <p>Naš kvart. Naš klub. Naš ponos.</p>
        </div>
      </div>

      <div class="history-layout">

        <div class="history-content">

          <p>
            NK Gavran svoju priču započinje <strong>26. listopada 2003. godine</strong> na zagrebačkom Laništu. Klub nosi ime po <strong>Damiru Tomljanoviću – Gavranu</strong>, hrvatskom branitelju i heroju Domovinskog rata, u čiju je čast osnovan.
          </p>

          <p>
            Od samih početaka klub je okupljao ljubitelje nogometa i mlade igrače s Laništa i okolnih kvartova. Seniorska momčad započela je natjecateljski put u sezoni <strong>2008./2009.</strong>
          </p>

          <p>
            Nakon prekida rada prvotnog kluba, <strong>13. lipnja 2017. godine</strong> osnovan je današnji NK Gavran 2003. Novi početak donio je i sportski uspjeh: već u sezoni <strong>2017./2018.</strong> klub je osvojio naslov prvaka <strong>3. Zagrebačke nogometne lige</strong>.
          </p>

          <p>
            Danas klub nastavlja svoju nogometnu priču kroz seniorsku momčad i školu nogometa, okupljajući nove generacije igrača. Naš cilj nije samo razvoj nogometnih vještina, već i stvaranje prijateljstava, zajedništva i osjećaja pripadnosti klubu i kvartu.
          </p>

          <p class="history-address">
            Naš dom nalazi se u <strong>Sportskom centru Gavran</strong>, na adresi <strong>Remetinečka cesta bb, Zagreb</strong>, preko puta hotela.
          </p>

          <a
            class="history-map"
            href="https://www.google.com/maps/search/?api=1&amp;query=Sportski+centar+Gavran+Remetinecka+Zagreb"
            target="_blank"
            rel="noopener noreferrer"
          >
            PRONAĐI NAS NA KARTI ↗
          </a>

        </div>

        <div class="history-visual">
          <img
            src="/images/nk-gavran-grb.png"
            alt="Grb NK Gavran 2003 Zagreb"
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- TRENERI I UPRAVA -->
  <section class="section alt" id="ljudi">
    <div class="container">

      <div class="section-head">
        <div>
          <div class="eyebrow">LJUDI KOJI STOJE IZA KLUBA</div>
          <h2>TRENERI I UPRAVA</h2>
          <p>Stručni rad, organizacija i podrška svim klupskim kategorijama.</p>
        </div>
      </div>

      <div class="people-grid">

        <article class="person-card">
          <img
            src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&amp;fit=crop&amp;w=700&amp;q=80"
            alt="Demo portret trenera"
            loading="lazy"
          />
          <div>
            <small>DEMO · TRENER MLAĐIH KATEGORIJA</small>
            <h3>Ante Novak</h3>
            <p>Razvoj osnovnih nogometnih vještina, koordinacije i timskog duha.</p>
          </div>
        </article>

        <article class="person-card">
          <img
            src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&amp;fit=crop&amp;w=700&amp;q=80"
            alt="Demo portret trenera"
            loading="lazy"
          />
          <div>
            <small>DEMO · TRENER JUNIORA</small>
            <h3>Ivan Kovač</h3>
            <p>Rad s mladim igračima i priprema za natjecateljski nogomet.</p>
          </div>
        </article>

        <article class="person-card">
          <img
            src="https://images.unsplash.com/photo-1566492031773-4f4e44671857?auto=format&amp;fit=crop&amp;w=700&amp;q=80"
            alt="Demo portret trenera"
            loading="lazy"
          />
          <div>
            <small>DEMO · TRENER SENIORA</small>
            <h3>Marko Horvat</h3>
            <p>Organizacija treninga i vođenje seniorske momčadi.</p>
          </div>
        </article>

      </div>

      <p class="demo-small">
        Sve prikazane osobe, imena i fotografije su demonstracijski primjeri, nisu potvrđeni članovi kluba.
      </p>

      <div class="board-facts leadership-facts">

        <div>
          <small>UPRAVA</small>
          <strong>Predsjednik kluba</strong>
          <p>Ime i prezime – u pripremi</p>
        </div>

        <div>
          <small>ORGANIZACIJA</small>
          <strong>Tajništvo</strong>
          <p>Kontakt i odgovorna osoba – u pripremi</p>
        </div>

        <div>
          <small>ŠKOLA NOGOMETA</small>
          <strong>Koordinator</strong>
          <p>Kontakt i odgovorna osoba – u pripremi</p>
        </div>

      </div>

    </div>
  </section>

  <!-- ZAVRŠNA CTA SEKCIJA -->
  <section class="cta">
    <div class="container cta-inner">

      <div>
        <div class="eyebrow" style="color:white">
          ŠKOLA NOGOMETA
        </div>

        <h2>POSTANI DIO GAVRANA.</h2>

        <p>
          Upoznaj klub, treniraj s vršnjacima i napravi svoje prve nogometne korake.
        </p>
      </div>

      <a class="btn btn-white" href="/skola-nogometa">
        INFORMACIJE O UPISU ↗
      </a>

    </div>
  </section>

</MainLayout>

<style>
  /* POVIJEST KLUBA */

  .history-section {
    background: #ffffff;
    padding: 95px 0;
  }

  .history-layout {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    align-items: center;
    gap: 85px;
  }

  .history-content {
    max-width: 700px;
  }

  /* Tekst povijesti */

  .history-content p {
    font-size: 15px;
    line-height: 1.85;
    color: #555555;
    margin: 0 0 18px;
  }

  .history-content strong {
    color: #191919;
    font-weight: 700;
  }

  /* Lokacija kluba */

  .history-content .history-address {
    border-left: 3px solid #d00000;
    padding-left: 18px;
    margin-top: 26px;
  }

  .history-map {
    display: inline-block;
    margin-top: 8px;
    color: #d00000;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .history-map:hover {
    color: #161616;
  }

  /* Grb desno */

  .history-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .history-visual img {
    display: block;
    width: 100%;
    max-width: 310px;
    height: auto;
    object-fit: contain;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  /* Tablet */

  @media (max-width: 900px) {
    .history-section {
      padding: 70px 0;
    }

    .history-layout {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .history-content {
      max-width: 100%;
    }

    .history-visual img {
      max-width: 230px;
    }
  }

  /* Mobitel */

  @media (max-width: 600px) {
    .history-section {
      padding: 55px 0;
    }

    .history-content p {
      font-size: 14px;
      line-height: 1.8;
    }

    .history-layout {
      gap: 35px;
    }

    .history-visual img {
      max-width: 185px;
    }
  }
</style>
